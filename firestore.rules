rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // transactions: userId, amount, type, category, desc, createdAt,
    //   bankDate; optional bank/imported/recurringId/occurrenceKey.
    // budgets: userId, month, category, limit, createdAt, updatedAt.
    // recurringTransactions: userId, type, category, description, amount,
    //   frequency, nextDueAt, active, createdAt, updatedAt.
    // groups: name, createdBy, members, memberNames, code, createdAt;
    //   optional currency for legacy compatibility.
    // inviteCodes: groupId, groupName, createdBy, currency, active, createdAt.
    // groupExpenses: groupId, description, amount, paidBy, splitAmong,
    //   createdBy, createdAt, settled; optional type/note/proofUrl.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(data) {
      return data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }

    function validShortString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function validOptionalUrl(data, field) {
      return !(field in data) || (
        data[field] is string &&
        data[field].size() <= 500 &&
        (data[field] == '' || data[field].matches('^https?://.*'))
      );
    }

    function validCurrency(value) {
      return value in ['INR', 'USD', 'EUR', 'GBP', 'AED'];
    }

    function validCategory(value) {
      return value in [
        'Rent', 'Food', 'Utilities', 'Entertainment', 'Transport', 'Shopping',
        'Health', 'Salary', 'Freelance', 'Business', 'Investment', 'Bonus',
        'Gift', 'Refund', 'Other'
      ];
    }

    function validTransaction(data) {
      return data.keys().hasAll(['userId', 'amount', 'type', 'category', 'desc', 'createdAt', 'bankDate']) &&
        data.keys().hasOnly(['userId', 'amount', 'type', 'category', 'desc', 'createdAt', 'bankDate', 'bank', 'imported', 'recurringId', 'occurrenceKey']) &&
        validShortString(data.userId, 1, 128) &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000000000 &&
        data.type in ['income', 'expense'] &&
        validCategory(data.category) &&
        data.desc is string && data.desc.size() <= 200 &&
        data.createdAt is timestamp &&
        data.bankDate is string && data.bankDate.size() <= 40 &&
        validOptionalString(data, 'bank', 50) &&
        (!('imported' in data) || data.imported is bool) &&
        validOptionalString(data, 'recurringId', 128) &&
        validOptionalString(data, 'occurrenceKey', 40);
    }

    function validBudget(data) {
      return data.keys().hasAll(['userId', 'month', 'category', 'limit', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'month', 'category', 'limit', 'createdAt', 'updatedAt']) &&
        validShortString(data.userId, 1, 128) &&
        data.month is string && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.category in ['Rent', 'Food', 'Utilities', 'Entertainment', 'Transport', 'Shopping', 'Health', 'Other'] &&
        data.limit is number && data.limit > 0 && data.limit <= 1000000000000 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validRecurring(data) {
      return data.keys().hasAll(['userId', 'type', 'category', 'description', 'amount', 'frequency', 'nextDueAt', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'type', 'category', 'description', 'amount', 'frequency', 'nextDueAt', 'active', 'createdAt', 'updatedAt']) &&
        validShortString(data.userId, 1, 128) &&
        data.type in ['income', 'expense'] &&
        validCategory(data.category) &&
        validShortString(data.description, 1, 100) &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000000000 &&
        data.frequency in ['weekly', 'monthly', 'yearly'] &&
        data.nextDueAt is timestamp && data.active is bool &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validGroup(data) {
      return data.keys().hasAll(['name', 'createdBy', 'members', 'memberNames', 'code', 'createdAt']) &&
        data.keys().hasOnly(['name', 'createdBy', 'members', 'memberNames', 'code', 'currency', 'createdAt']) &&
        validShortString(data.name, 1, 80) &&
        validShortString(data.createdBy, 1, 128) &&
        data.members is list && data.members.size() >= 1 && data.members.size() <= 50 &&
        data.memberNames is map && data.memberNames.size() <= 50 &&
        data.code is string && data.code.matches('^[A-HJ-NP-Z2-9]{7}$') &&
        (!('currency' in data) || validCurrency(data.currency)) &&
        data.createdAt is timestamp;
    }

    function validInvite(data) {
      return data.keys().hasAll(['groupId', 'groupName', 'createdBy', 'currency', 'active', 'createdAt']) &&
        data.keys().hasOnly(['groupId', 'groupName', 'createdBy', 'currency', 'active', 'createdAt']) &&
        validShortString(data.groupId, 1, 128) &&
        validShortString(data.groupName, 1, 80) &&
        validShortString(data.createdBy, 1, 128) &&
        validCurrency(data.currency) && data.active is bool && data.createdAt is timestamp;
    }

    function validGroupExpense(data) {
      return data.keys().hasAll(['groupId', 'description', 'amount', 'paidBy', 'splitAmong', 'createdBy', 'createdAt', 'settled']) &&
        data.keys().hasOnly(['groupId', 'description', 'amount', 'paidBy', 'splitAmong', 'createdBy', 'createdAt', 'settled', 'type', 'note', 'proofUrl']) &&
        validShortString(data.groupId, 1, 128) &&
        validShortString(data.description, 1, 200) &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000000000 &&
        validShortString(data.paidBy, 1, 128) &&
        data.splitAmong is list && data.splitAmong.size() >= 1 && data.splitAmong.size() <= 50 &&
        validShortString(data.createdBy, 1, 128) && data.createdAt is timestamp && data.settled is bool &&
        (!('type' in data) || data.type == 'settlement') &&
        validOptionalString(data, 'note', 200) && validOptionalUrl(data, 'proofUrl');
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)) && request.auth.uid in groupData(groupId).members;
    }

    function isGroupOwner(groupId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/groups/$(groupId)) && groupData(groupId).createdBy == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && uidUnchanged(request.resource.data) && validTransaction(request.resource.data);
      allow update: if isOwner(resource.data.userId) && uidNotModified() && validTransaction(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /budgets/{budgetId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && uidUnchanged(request.resource.data) && validBudget(request.resource.data);
      allow update: if isOwner(resource.data.userId) && uidNotModified() && validBudget(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /recurringTransactions/{recurringId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && uidUnchanged(request.resource.data) && validRecurring(request.resource.data);
      allow update: if isOwner(resource.data.userId) && uidNotModified() && validRecurring(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextDueAt', 'updatedAt', 'active']);
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() && validGroup(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.members == [request.auth.uid] &&
        request.resource.data.memberNames.keys().hasOnly([request.auth.uid]) &&
        validShortString(request.resource.data.memberNames[request.auth.uid], 1, 80);
      allow update: if isAuthenticated() && validGroup(request.resource.data) &&
        !(request.auth.uid in resource.data.members) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.members.toSet().hasAll(resource.data.members.toSet()) &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]) &&
        validShortString(request.resource.data.memberNames[request.auth.uid], 1, 80) &&
        exists(/databases/$(database)/documents/inviteCodes/$(resource.data.code)) &&
        get(/databases/$(database)/documents/inviteCodes/$(resource.data.code)).data.active == true &&
        get(/databases/$(database)/documents/inviteCodes/$(resource.data.code)).data.groupId == groupId;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /inviteCodes/{inviteCode} {
      allow get: if isAuthenticated() && resource.data.active == true;
      allow list: if false;
      allow create: if isAuthenticated() && validInvite(request.resource.data) &&
        inviteCode.matches('^[A-HJ-NP-Z2-9]{7}$') && request.resource.data.createdBy == request.auth.uid &&
        (
          (exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
            groupData(request.resource.data.groupId).createdBy == request.auth.uid &&
            groupData(request.resource.data.groupId).code == inviteCode) ||
          (existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
            getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid &&
            getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.code == inviteCode)
        );
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid && validInvite(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) &&
        request.resource.data.groupId == resource.data.groupId && request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /groupExpenses/{expenseId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isAuthenticated() && validGroupExpense(request.resource.data) &&
        isGroupMember(request.resource.data.groupId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.paidBy in groupData(request.resource.data.groupId).members &&
        groupData(request.resource.data.groupId).members.toSet().hasAll(request.resource.data.splitAmong.toSet()) &&
        (!('type' in request.resource.data) || request.resource.data.paidBy == request.auth.uid);
      allow update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isGroupOwner(resource.data.groupId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
